# ============================================================
# Шаблон окружения. Скопируйте в .env и заполните значениями.
# НИКОГДА не коммитьте .env с секретами!
# ============================================================

# Токен бота от @BotFather (используется и для проверки initData)
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Telegram ID менеджеров через запятую (@userinfobot)
MANAGER_IDS=123456789,987654321

# Реквизиты для оплаты (реальные — не оставляйте 0000 / «Иванов»)
PAYMENT_DETAILS=Сбербанк XXXX XXXX XXXX XXXX, Получатель Ф.И.О.

# HTTPS URL мини-приложения (на VPS обычно тот же хост, что API)
MINI_APP_URL=https://your-domain.example/

# Публичный URL API без слеша в конце (тот же хост на VPS)
PUBLIC_API_URL=https://your-domain.example

# CORS: origin фронта (без пути). На VPS — тот же домен Mini App
CORS_ORIGIN=https://your-domain.example

# Несколько origin через запятую (опционально)
# CORS_ORIGINS=https://your-domain.example,http://localhost:8080

# Порт HTTP-сервера бота (за Nginx обычно 8080)
PORT=8080

# SQLite (локально / на VPS, если DATABASE_URL пуст)
DATABASE_PATH=bot_data.db

# PostgreSQL (рекомендуется при росте нагрузки)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Прокси к api.telegram.org — обычно НЕ нужен на VPS
# PROXY_URL=socks5://user:password@host:1080

# DEBUG=true: /test_order и ослабленная проверка initData. В production — false
DEBUG=false

# Если PAYMENT_DETAILS ещё заглушка — бот в проде НЕ стартует.
# Временно (только миграция): ALLOW_PAYMENT_STUB=true
# ALLOW_PAYMENT_STUB=false

# Telegram updates: webhook (рекомендуется на VPS с HTTPS) или polling
USE_WEBHOOK=true
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-me-to-random-string

# Avito ОТКЛЮЧЁН навсегда. Каталог ведётся вручную в Mini App (Аккаунт → Админ).
# Переменные AVITO_* не используются.
